#!/usr/bin/env bash
# fenced — run a coding agent (claude, codex, ...) in yolo mode inside a fence
# (https://github.com/fencesandbox/fence) sandbox that can only see the current
# directory plus explicitly granted folders. Network is fully open.
#
# Invoke via a symlink named after the tool (bin/claude -> ../fenced), or as
# `fenced <tool> [args...]`. See README.md for usage and CLAUDE.md for design.
set -euo pipefail

SELF=$(realpath "${BASH_SOURCE[0]}")
SELF_DIR=$(dirname "$SELF")
H=$HOME

die() { printf 'fenced: %s\n' "$*" >&2; exit 1; }
note() { [[ ${FENCED_QUIET:-0} == 1 ]] || printf 'fenced: %s\n' "$*" >&2; }

usage() {
  cat <<'EOF'
Usage: claude|codex|... [fence options] [tool args...]
       fenced <tool> [fence options] [tool args...]
       fenced gh-token [DIR]  Set a GitHub token limited to the repo (default: cwd's repo)

Runs <tool> in yolo mode inside a fence sandbox. Read/write: the current
directory (plus the main repo of a git worktree). Everything else in $HOME is
invisible unless granted. Network is unrestricted, ports bind on the host.

Fence options (must come before any tool args):
  --fence-ro DIR      Grant read-only access to DIR (also passed as --add-dir)
  --fence-rw DIR      Grant read-write access to DIR (also passed as --add-dir)
  --fence-herdr       Expose the herdr socket (agent status; lets the agent drive herdr)
  --fence-shell [ARGS]  Run bash (with ARGS) in the same sandbox instead of the tool
  --fence-dry-run     Print the fence config and command, don't run
  --fence-help        This help

A tool arg `--add-dir DIR` is passed through and also grants read-write access.

Environment:
  FENCED_RO, FENCED_RW   Colon-separated extra read-only / read-write dirs
  FENCED_HERDR=1         Same as --fence-herdr
  FENCED_OFF=1           Run the real tool unfenced (escape hatch)
  FENCED_DEBUG=1         Run fence with --debug
  FENCED_QUIET=1         No startup summary
  FENCED_<TOOL>_BIN      Path to the real binary (e.g. FENCED_CLAUDE_BIN)

Config: ~/.config/claude-fenced/config (bash; may set FENCED_RO_DIRS=(...),
FENCED_RW_DIRS=(...), FENCED_HERDR=1, FENCED_MISE_TOOLS=(...)). Not visible
inside the sandbox.

Inside the fence, mise tools' real bin dirs come first on PATH and ~/.local/bin
(Omarchy's mise wrappers, which can't run there) last. FENCED_MISE_TOOLS
(default: gh playwright) are installed with mise first if missing.

Per-project env: ~/.config/claude-fenced/projects/<abs dir>.env is sourced for
the work dir and each parent (and a worktree's main repo), outside the fence.
GH_TOKEN there also configures git for github.com. See README.md.
EOF
}

# Per-project env files (tokens etc.) mirror the project path under here, e.g.
# ~/.config/claude-fenced/projects/home/me/Projects/foo.env. The directory is
# invisible inside the fence, so a project only ever sees its own values.
PROJ_ENV_DIR=${XDG_CONFIG_HOME:-$H/.config}/claude-fenced/projects

# Fine-grained GitHub token for one repo: everything a dev workflow needs,
# nothing administrative. GitHub has no API for creating PATs, but its "new
# token" page takes prefilled settings from the URL; only the repository has to
# be picked by hand ("Only select repositories").
# No workflows=write by default: editing .github/workflows lets the agent run
# arbitrary CI with the repo's secrets. FENCED_TOKEN_WORKFLOWS=1 adds it.
TOKEN_PERMS=(contents=write pull_requests=write issues=write discussions=write
             actions=read statuses=read metadata=read)
[[ ${FENCED_TOKEN_WORKFLOWS:-0} == 1 ]] && TOKEN_PERMS+=(workflows=write)
token_url() {  # owner repo
  local enc name host pre post qs p
  enc() { jq -rn --arg v "$1" '$v|@uri'; }
  host=$(hostname -s)
  # Names must be unique and <= 40 chars: shorten the repo part if needed.
  pre="$host fenced " post=" $(date +%F)"
  name="$pre${2:0:$((40 - ${#pre} - ${#post}))}$post"
  qs="name=$(enc "$name")&description=$(enc "claude-fenced agent token for $1/$2 on $host")"
  qs+="&target_name=$(enc "$1")&expires_in=${FENCED_TOKEN_DAYS:-365}"
  for p in "${TOKEN_PERMS[@]}"; do qs+="&$p"; done
  printf 'https://github.com/settings/personal-access-tokens/new?%s' "$qs"
}

# `fenced gh-token [DIR]`: set GH_TOKEN for DIR's repo (default: the current
# git repo's main root, so worktrees and subdirs share it). Shows a prefilled
# token link and takes the token at a prompt; Enter alone opens the env file.
gh_token_cmd() {
  local dir gd remote owner repo url f tok new
  dir=$(realpath -e -- "${1:-$PWD}") || die "no such dir: ${1:-$PWD}"
  if [[ -z ${1:-} ]] && gd=$(git -C "$dir" rev-parse --path-format=absolute --git-common-dir 2>/dev/null); then
    dir=$(dirname "$gd")
  fi
  remote=$(git -C "$dir" remote get-url origin 2>/dev/null) || die "no 'origin' remote in $dir"
  [[ $remote =~ github\.com[:/]+([^/]+)/([^/]+)$ ]] || die "origin is not on github.com: $remote"
  owner=${BASH_REMATCH[1]} repo=${BASH_REMATCH[2]%.git}
  url=$(token_url "$owner" "$repo")

  f=$PROJ_ENV_DIR$dir.env
  if [[ ! -e $f ]]; then
    mkdir -p -m 700 "$(dirname "$f")"
    (umask 077; cat >"$f" <<EOF
# Environment for fenced agents started in $dir (or below).
# Sourced by bash outside the fence; only the values are passed in.
# Add other variables as needed.
#
# GH_TOKEN: a fine-grained PAT for $owner/$repo only (\`fenced gh-token\` sets it).
# git and gh use it; git@github.com: remotes are rewritten to https.
GH_TOKEN=
EOF
    )
  fi
  tok=$(set -a; source "$f" >/dev/null 2>&1; printf '%s' "${GH_TOKEN:-}")

  # Usually run over ssh (often inside herdr), where a long URL wraps and can't
  # be clicked reliably, and xdg-open would open on the wrong machine. So: copy
  # it to the *local* clipboard (OSC 52), print a short clickable link (OSC 8),
  # and the plain URL as a fallback.
  printf 'GitHub token for %s/%s: open the link, choose "Only select repositories" -> %s,\nand generate.\n\n' "$owner" "$repo" "$repo" >&2
  if [[ -t 2 ]]; then
    printf '\e]52;c;%s\a' "$(printf '%s' "$url" | base64 -w0)" >&2
    printf '  \e]8;;%s\e\\>> Open the new-token page <<\e]8;;\e\\  (link also copied to your clipboard)\n\n' "$url" >&2
  fi
  printf '  %s\n\n' "$url" >&2
  [[ -n $tok ]] && echo "A token is already set; pasting a new one replaces it." >&2

  if [[ -t 0 ]]; then
    new=$(read_masked "Paste token (or just Enter to edit $(basename "$f") instead): ")
  else
    read -r new || true
  fi
  new=${new//[[:space:]]/}
  # Pasted twice (easy with no visible feedback)? Keep one copy.
  local half=$(( ${#new} / 2 ))
  (( ${#new} % 2 == 0 && half > 0 )) && [[ ${new:0:half} == "${new:half}" ]] && new=${new:0:half}
  if [[ -n $new ]]; then
    [[ $new =~ ^(github_pat_|ghp_)[A-Za-z0-9_]+$ ]] || die "that doesn't look like a GitHub token; nothing saved"
    check_token "$new" "$owner" "$repo" || die "nothing saved"
    if grep -q '^GH_TOKEN=' "$f"; then
      sed -i "s|^GH_TOKEN=.*|GH_TOKEN=$new|" "$f"
    else
      printf 'GH_TOKEN=%s\n' "$new" >>"$f"
    fi
    echo "Saved to $f" >&2
    exit 0
  fi

  # Manual edit, in a terminal editor: over ssh a GUI editor opens on the wrong
  # screen and returns immediately. Omarchy's launcher starts GUI defaults (e.g.
  # code) detached, so it's replaced by nano. FENCED_EDITOR overrides.
  echo "$f" >&2
  local -a ed; read -ra ed <<<"${FENCED_EDITOR:-${VISUAL:-${EDITOR:-nano}}}"
  [[ -z ${FENCED_EDITOR:-} && ${ed[0]##*/} == omarchy-launch-editor ]] && ed=(nano)
  "${ed[@]}" "$f"
  tok=$(set -a; source "$f" >/dev/null 2>&1; printf '%s' "${GH_TOKEN:-}")
  if [[ -n $tok ]]; then check_token "$tok" "$owner" "$repo"; exit $?; fi
  exit 0
}

# Read a secret from the terminal, echoing one * per character (so a paste is
# visibly received); Backspace works. Prompt and stars go to stderr.
read_masked() {
  local c v=""
  printf '%s' "$1" >&2
  while IFS= read -rsn1 c; do
    [[ -z $c ]] && break                              # Enter
    if [[ $c == $'\x7f' || $c == $'\b' ]]; then
      [[ -n $v ]] && { v=${v%?}; printf '\b \b' >&2; }
      continue
    fi
    v+=$c; printf '*' >&2
  done
  echo >&2
  printf '%s' "$v"
}

check_token() {  # token owner repo
  local push
  if push=$(GH_TOKEN=$1 gh api "repos/$2/$3" --jq .permissions.push 2>/dev/null) && [[ $push == true ]]; then
    echo "GH_TOKEN: push access to $2/$3 OK" >&2
  else
    echo "GH_TOKEN: WARNING: can't push to $2/$3 with this token (repo not selected? expired?)" >&2
    return 1
  fi
}

# --- which tool? ------------------------------------------------------------
tool=$(basename "$0")
if [[ $tool == fenced ]]; then
  [[ $# -gt 0 ]] || { usage; exit 1; }
  case $1 in
    -h|--help|--fence-help) usage; exit 0 ;;
    gh-token) shift; gh_token_cmd "$@" ;;
  esac
  tool=$1; shift
fi

# --- find the real binary (skipping ourselves) -------------------------------
resolve_real() {
  local var="FENCED_${tool^^}_BIN" dir cand
  var=${var//-/_}
  if [[ -n ${!var:-} ]]; then printf '%s' "${!var}"; return; fi
  local IFS=:
  for dir in $PATH; do
    cand=$dir/$tool
    [[ -x $cand && ! -d $cand ]] || continue
    [[ $(realpath "$cand") == "$SELF" ]] && continue
    # Omarchy installs tools via mise and puts a tiny wrapper script in
    # ~/.local/bin that updates the tool (`mise use -g`) and then `mise x`-es
    # it. Do the update step out here (it needs write access to mise dirs),
    # then fence the real binary so its argv[0] basename stays "$tool".
    if head -c 4096 "$cand" 2>/dev/null | grep -q 'mise x'; then
      if [[ -z ${FENCE_SANDBOX:-} ]]; then
        MISE_MINIMUM_RELEASE_AGE=0 mise use -g --quiet "$tool" >&2 || true
      fi
      mise which "$tool" 2>/dev/null && return
      continue
    fi
    printf '%s' "$cand"; return
  done
  return 1
}
real=$(resolve_real) || die "can't find the real '$tool' on PATH"

# --- tool profiles -------------------------------------------------------------
# yolo:     flag that disables the tool's own permission prompts/sandbox
# state_rw: the tool's config/history (read-write)
# protect:  config paths that would let a fenced agent get code executed by a
#           later session (hooks, statusline, plugins, notify...); read-only
yolo=() state_rw=() protect=() add_dir_flag=""
extra_env=()
case $tool in
  claude)
    yolo=(--dangerously-skip-permissions); add_dir_flag=--add-dir
    state_rw=("$H/.claude")
    protect=("$H/.claude/"{settings.json,settings.local.json,hooks,plugins,skills,agents,commands,output-styles,CLAUDE.md} "$H"/.claude/statusline*)
    # Claude keeps its main state in ~/.claude.json and saves it via a lock dir
    # and temp file *next to it*, i.e. in $HOME, which is not writable in the
    # fence. So the file lives in ~/.claude/ with a symlink at the old path for
    # unfenced use (claude resolves the symlink), and inside the fence
    # CLAUDE_CONFIG_DIR points claude at ~/.claude/.claude.json directly.
    extra_env=(CLAUDE_CONFIG_DIR="$H/.claude")
    ;;
  codex)
    yolo=(--dangerously-bypass-approvals-and-sandbox); add_dir_flag=--add-dir
    state_rw=("${CODEX_HOME:-$H/.codex}")
    protect=("${CODEX_HOME:-$H/.codex}/"{config.toml,AGENTS.md,skills,prompts,rules})
    ;;
  gemini)
    yolo=(--yolo); add_dir_flag=--include-directories
    state_rw=("$H/.gemini")
    protect=("$H/.gemini/settings.json")
    ;;
  *)
    [[ -d $H/.$tool ]] && state_rw=("$H/.$tool")
    ;;
esac

# Already inside a fence (e.g. the agent runs `claude -p` itself): run directly.
if [[ -n ${FENCE_SANDBOX:-} || ${FENCED_OFF:-0} == 1 ]]; then
  [[ ${FENCED_OFF:-0} == 1 ]] && note "FENCED_OFF=1: running $tool UNFENCED"
  for e in "${extra_env[@]}"; do [[ -n ${FENCE_SANDBOX:-} ]] && export "$e"; done
  exec -a "$tool" "$real" "${yolo[@]}" "$@"
fi

command -v fence >/dev/null || die "fence not found (see README.md)"
command -v jq >/dev/null || die "jq not found"

# --- options -------------------------------------------------------------------
FENCED_RO_DIRS=() FENCED_RW_DIRS=() FENCED_MISE_TOOLS=(gh playwright)
cfg=${XDG_CONFIG_HOME:-$H/.config}/claude-fenced/config
# shellcheck source=/dev/null
[[ -f $cfg ]] && source "$cfg"
ro=("${FENCED_RO_DIRS[@]}") rw=("${FENCED_RW_DIRS[@]}")
IFS=: read -ra _ro <<<"${FENCED_RO:-}"; ro+=("${_ro[@]}")
IFS=: read -ra _rw <<<"${FENCED_RW:-}"; rw+=("${_rw[@]}")
herdr=${FENCED_HERDR:-0} shell=0 dry=0 add_dirs=()

while [[ $# -gt 0 ]]; do
  case $1 in
    --fence-ro) [[ $# -ge 2 ]] || die "$1 needs a dir"; ro+=("$2"); add_dirs+=("$2"); shift 2 ;;
    --fence-ro=*) ro+=("${1#*=}"); add_dirs+=("${1#*=}"); shift ;;
    --fence-rw) [[ $# -ge 2 ]] || die "$1 needs a dir"; rw+=("$2"); add_dirs+=("$2"); shift 2 ;;
    --fence-rw=*) rw+=("${1#*=}"); add_dirs+=("${1#*=}"); shift ;;
    --fence-herdr) herdr=1; shift ;;
    --fence-shell) shell=1; shift ;;
    --fence-dry-run) dry=1; shift ;;
    --fence-help) usage; exit 0 ;;
    --fence-*) die "unknown option $1 (see --fence-help)" ;;
    *) break ;;
  esac
done
tool_args=("$@")

# Tool-level dir args also need filesystem access.
for ((i = 0; i < ${#tool_args[@]}; i++)); do
  a=${tool_args[i]}
  case $a in
    --add-dir|--include-directories|-C|--cd) [[ -n ${tool_args[i+1]:-} ]] && rw+=("${tool_args[i+1]}") ;;
    --add-dir=*|--include-directories=*|--cd=*) rw+=("${a#*=}") ;;
  esac
done
if [[ -n $add_dir_flag ]]; then
  for d in "${add_dirs[@]}"; do tool_args=("$add_dir_flag" "$d" "${tool_args[@]}"); done
fi

# --- paths ---------------------------------------------------------------------
abs() { realpath -m -- "${1/#\~/$H}"; }
# Refuse dirs that would expose all of $HOME (or more).
guard() {
  local p=$1
  [[ $p == / || $p == "$H" || $H == "$p"/* ]] && die "refusing to grant access to $p (would expose \$HOME)"
  return 0
}

work=$(abs "$PWD"); guard "$work"
allow_write=("$work")
allow_read=()

for d in "${rw[@]}"; do [[ -n $d ]] || continue; d=$(abs "$d"); guard "$d"; [[ -e $d ]] || die "no such dir: $d"; allow_write+=("$d"); done
for d in "${ro[@]}"; do [[ -n $d ]] || continue; d=$(abs "$d"); guard "$d"; [[ -e $d ]] || die "no such dir: $d"; allow_read+=("$d"); done

# Git worktree: the shared .git dir of the main repo must be writable to commit.
if gd=$(git -C "$work" rev-parse --path-format=absolute --git-common-dir 2>/dev/null); then
  [[ $gd == "$work"/* ]] || { allow_write+=("$gd"); note "git: also granting $gd"; }
fi

# Per-project env: <PROJ_ENV_DIR><dir>.env for the work dir and each ancestor
# (outermost first, so inner files override), and for a worktree also the main
# repo's chain (applied before the work dir's).
env_chain() {
  local d=$1 chain=()
  while [[ $d != / ]]; do chain=("$PROJ_ENV_DIR$d.env" "${chain[@]}"); d=$(dirname "$d"); done
  printf '%s\n' "${chain[@]}"
}
env_files=()
[[ -n ${gd:-} ]] && mapfile -t -O 0 env_files < <(env_chain "$(dirname "$gd")")
mapfile -t -O "${#env_files[@]}" env_files < <(env_chain "$work")
declare -A seen_env=()
for f in "${env_files[@]}"; do
  [[ -f $f && -z ${seen_env[$f]:-} ]] || continue
  seen_env[$f]=1
  [[ $(stat -c %a "$f") == ?00 ]] || note "warning: $f is readable by others (chmod 600)"
  before=$(compgen -e)
  set -a
  # shellcheck source=/dev/null
  source "$f"
  set +a
  note "env: ${f#"$PROJ_ENV_DIR"} ($(comm -13 <(sort <<<"$before") <(compgen -e | sort) | xargs))"
done

# Empty values (e.g. the template's `GH_TOKEN=`) count as unset.
for v in GH_TOKEN GITHUB_TOKEN; do [[ -n ${!v:-} ]] || unset "$v"; done

# A GitHub token also serves git: credential helper and ssh->https rewrite,
# configured via GIT_CONFIG_* env so nothing is written to disk.
if [[ -n ${GH_TOKEN:-${GITHUB_TOKEN:-}} ]]; then
  gc=${GIT_CONFIG_COUNT:-0}
  gitcfg() { export "GIT_CONFIG_KEY_$gc=$1" "GIT_CONFIG_VALUE_$gc=$2"; gc=$((gc + 1)); }
  gitcfg credential.https://github.com.helper ''   # drop inherited helpers
  gitcfg credential.https://github.com.helper \
    '!f() { test "$1" = get && echo username=x-access-token && echo "password=${GH_TOKEN:-$GITHUB_TOKEN}"; }; f'
  gitcfg url.https://github.com/.insteadOf git@github.com:
  gitcfg url.https://github.com/.insteadOf ssh://git@github.com/
  export GIT_CONFIG_COUNT=$gc
fi

# Tool state (read-write) and executable config (read-only again).
allow_write+=("${state_rw[@]}")
deny_write=()
for p in "${protect[@]}"; do [[ -e $p ]] && deny_write+=("$p"); done

# Claude: move ~/.claude.json into ~/.claude/ (see profile comment above).
if [[ $tool == claude && ! -L $H/.claude.json && -f $H/.claude.json && $dry == 0 ]]; then
  if [[ -e $H/.claude/.claude.json ]]; then
    die "both ~/.claude.json and ~/.claude/.claude.json exist; resolve manually"
  fi
  cp -p "$H/.claude.json" "$H/.claude/.claude.json"
  ln -s .claude/.claude.json "$H/.claude.json.fenced-tmp"
  mv -T "$H/.claude.json.fenced-tmp" "$H/.claude.json"   # atomic swap
  note "moved ~/.claude.json to ~/.claude/.claude.json (symlink left in place)"
fi

# Toolchains and caches. Read-only: mise installs/config, git config.
# Read-write: package caches (data only — no dirs whose binaries run unfenced).
# fence can only grant paths that exist, and tools create their cache lazily
# (mvnw's first step is mkdir ~/.m2/wrapper), so pre-create the common ones.
# ~/.vaadin: Vaadin keeps its license keys (userKey/proKey) and a node download there.
# Not ~/go or ~/.cargo: their toolchains are installed unfenced and create them.
[[ $tool == claude ]] && mkdir -p "$H/.cache/claude-cli-nodejs"
mkdir -p "$H/.m2/repository" "$H/.m2/wrapper" "$H/.gradle/caches" "$H/.gradle/wrapper" "$H/.npm" \
         "$H/.cache/pip" "$H/.cache/uv" "$H/.cache/ms-playwright" "$H/.cache/node-gyp" "$H/.vaadin" 2>/dev/null || true
for p in "$H/.local/share/mise" "${XDG_CONFIG_HOME:-$H/.config}/mise" "$H/.gitconfig" "$H/.config/git" "$SELF_DIR" "$H/.orca"; do
  [[ -e $p ]] && allow_read+=("$p")
done
for p in "$H/.cache/claude-cli-nodejs" "$H/.npm" "$H/.m2/repository" "$H/.m2/wrapper" "$H/.gradle/caches" "$H/.gradle/wrapper" \
         "$H/.cargo/registry" "$H/.cargo/git" "$H/.cache/pip" "$H/.cache/uv" "$H/.cache/go-build" \
         "$H/go/pkg/mod" "$H/.cache/ms-playwright" "$H/.cache/node-gyp" "$H/.local/share/pnpm" "$H/.vaadin"; do
  [[ -e $p ]] && allow_write+=("$p")
done

# herdr (terminal agent manager): its hook reports status over a unix socket.
# That socket API can also create panes / send keys = run commands unfenced,
# so it's opt-in.
if [[ $herdr == 1 ]]; then
  if [[ -n ${HERDR_SOCKET_PATH:-} && -S $HERDR_SOCKET_PATH ]]; then
    allow_write+=("$HERDR_SOCKET_PATH")
  else
    note "--fence-herdr: no HERDR_SOCKET_PATH socket in env, ignoring"
  fi
fi

# /run/user/$UID holds the D-Bus session bus (systemd-run --user = escape,
# keyring), hyprland, pipewire, gnupg... Fence mounts /run read-only but
# sockets stay connectable, so hide it.
deny_read=("/run/user/$(id -u)")

# --- fence config ------------------------------------------------------------------
json_array() { if [[ $# -eq 0 ]]; then echo '[]'; else printf '%s\n' "$@" | jq -R . | jq -s 'unique'; fi; }
# allowedDomains "*": no network namespace, so outbound is direct and ports
# bind on the host (reachable over tailscale). allowPty: TUI resize handling,
# and keeps the tool in a foreground process group so Orca recognizes it.
settings=$(jq -n \
  --argjson allowRead "$(json_array "${allow_read[@]}")" \
  --argjson allowWrite "$(json_array "${allow_write[@]}")" \
  --argjson denyWrite "$(json_array "${deny_write[@]}")" \
  --argjson denyRead "$(json_array "${deny_read[@]}")" \
  '{network: {allowedDomains: ["*"], allowLocalBinding: true, allowLocalOutbound: true},
    filesystem: {defaultDenyRead: true, allowRead: $allowRead, allowWrite: $allowWrite,
                 denyWrite: $denyWrite, denyRead: $denyRead},
    allowPty: true}')

if [[ $shell == 1 ]]; then
  # Interactive: ~/.bashrc is unreadable in the fence; use our own rc file
  # (fence strips PS1 from the environment, so it can't be passed in).
  if [[ ${#tool_args[@]} -eq 0 ]]; then
    export FENCED_TOOL=$tool
    cmd=(bash --rcfile "$SELF_DIR/fence-shell.rc")
  else
    cmd=(bash "${tool_args[@]}")
  fi
else
  cmd=("$real" "${yolo[@]}" "${tool_args[@]}")
fi
# PATH inside the fence. Omarchy's ~/.local/bin mise wrappers run `mise use -g`
# first, which needs write access to mise's config, installs and caches, so they
# fail in the fence. Put mise's real bin dirs first (after our bin/, so a nested
# `claude` still gets its yolo flag) and ~/.local/bin last. FENCED_MISE_TOOLS are
# installed out here if missing (e.g. playwright's wrapper installs on first
# run); updating them is left to unfenced use.
fence_path() {
  local t spec p lb bin out=() res=() last=() ps
  local -A seen=()
  lb=$(realpath -m -- "$H/.local/bin") bin=$SELF_DIR/bin
  if command -v mise >/dev/null; then
    for t in "${FENCED_MISE_TOOLS[@]}"; do
      mise which "$t" >/dev/null 2>&1 && continue
      spec=$(sed -n 's/^mise use -g --quiet "\([^"]*\)".*/\1/p' "$H/.local/bin/$t" 2>/dev/null | head -1)
      [[ -n $spec ]] || continue
      note "installing $t ($spec) with mise"
      MISE_MINIMUM_RELEASE_AGE=0 mise use -g --quiet "$spec" >&2 || note "  failed: $t won't work in the fence"
    done
    mapfile -t out < <(mise bin-paths 2>/dev/null)
  fi
  IFS=: read -ra ps <<<"$PATH"
  [[ :$PATH: == *:"$bin":* ]] && out=("$bin" "${out[@]}")
  out+=("${ps[@]}")
  for p in "${out[@]}"; do
    [[ -n $p && -z ${seen[$p]:-} ]] || continue
    seen[$p]=1
    if [[ $(realpath -m -- "$p") == "$lb" ]]; then last+=("$p"); else res+=("$p"); fi
  done
  res+=("${last[@]}")
  local IFS=:; printf '%s' "${res[*]}"
}
PATH=$(fence_path)

# Environment for inside the sandbox: strip handles to host services.
unset DBUS_SESSION_BUS_ADDRESS SSH_AUTH_SOCK GPG_AGENT_INFO
[[ $herdr == 1 ]] || unset HERDR_SOCKET_PATH HERDR_ENV HERDR_PANE_ID
for e in "${extra_env[@]}"; do export "$e"; done

fence_flags=()
[[ ${FENCED_DEBUG:-0} == 1 ]] && fence_flags+=(--debug)

if [[ $dry == 1 ]]; then
  printf '%s\n' "$settings"
  printf 'command:'; printf ' %q' "${extra_env[@]}" fence "${fence_flags[@]}" --settings '<above>' -- "${cmd[@]}"; echo
  exit 0
fi

note "$tool fenced to $work"
for d in "${rw[@]}"; do [[ -n $d ]] && note "  rw: $(abs "$d")"; done
for d in "${ro[@]}"; do [[ -n $d ]] && note "  ro: $(abs "$d")"; done

# Settings go in via an fd, so no temp file is left behind and no repo-local
# fence.json can be picked up. argv[0] "$tool" helps Orca's fast-path detection.
exec 3<<<"$settings"
exec -a "$tool" fence "${fence_flags[@]}" --settings /dev/fd/3 -- "${cmd[@]}"
